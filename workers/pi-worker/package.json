{
  "name": "@arcvellum/pi-worker",
  "version": "0.98.0",
  "description": "Bounded Pi Agent Core worker embedded in ArcVellum",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": {
    "arcvellum-pi-worker": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsc -p tsconfig.build.json && node ./scripts/build.mjs",
    "test": "vitest --run",
    "check": "npm run clean && npm run build && npm run test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "private": true
}

{
  "name": "arcvellum-studio",
  "private": true,
  "version": "0.98.0",
  "scripts": {
    "api:openapi": "python scripts/export_studio_openapi.py --output contracts/openapi/arcvellum-studio-v1.json",
    "api:types": "openapi-typescript contracts/openapi/arcvellum-studio-v1.json -o client/src/types/generated/api-schema.d.ts",
    "api:contracts": "npm run api:openapi && npm run api:types",
    "api:contracts:check": "python scripts/export_studio_openapi.py --output contracts/openapi/arcvellum-studio-v1.json --check && npm run api:types && git diff --exit-code -- contracts/openapi/arcvellum-studio-v1.json client/src/types/generated/api-schema.d.ts",
    "client:dev": "vite --config client/vite.config.ts",
    "client:build": "vue-tsc -p client/tsconfig.json --noEmit && vite build --configLoader runner --config client/vite.config.ts && node scripts/sync-desktop-frontend.mjs && node scripts/verify-v09-build.mjs",
    "client:verify-build": "node scripts/verify-v09-build.mjs",
    "client:benchmark:narrative": "vitest run --config client/vitest.config.ts client/src/features/orrery/layout/largeScaleLayout.spec.ts --reporter verbose",
    "client:test": "vitest run --configLoader runner --config client/vitest.config.ts",
    "client:test:watch": "vitest --configLoader runner --config client/vitest.config.ts",
    "client:test:visual": "playwright test --config client/playwright.config.cjs",
    "client:test:visual:headed": "playwright test --config client/playwright.config.cjs --headed",
    "pi-worker:install": "npm --prefix workers/pi-worker ci --ignore-scripts",
    "pi-worker:build": "npm --prefix workers/pi-worker run build",
    "pi-worker:test": "npm --prefix workers/pi-worker run test",
    "pi-worker:check": "npm --prefix workers/pi-worker run check",
    "tauri": "tauri",
    "desktop:dev": "npm run client:build && tauri dev",
    "desktop:verify-sidecar": "python packaging/sidecar_provenance.py verify --root . --binary desktop/src-tauri/binaries/literary-engineering-studio-sidecar-x86_64-pc-windows-msvc.exe --manifest build/sidecar-provenance.json",
    "desktop:verify-pi-worker": "python packaging/pi_worker_bundle.py verify --root . --destination desktop/src-tauri/resources/pi-worker",
    "desktop:build": "npm run client:build && npm run desktop:verify-sidecar && npm run desktop:verify-pi-worker && tauri build",
    "desktop:icons": "tauri icon desktop/app-icon.svg --output desktop/src-tauri/icons"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.13.3",
    "@types/penner": "^0.1.3",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "2.4",
    "jsdom": "^26.1.0",
    "openapi-typescript": "7.10.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/markdown-it": "^14.1.2",
    "dompurify": "3.4.13",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.3.0",
    "penner": "^0.1.3",
    "pinia": "^3.0.4",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.19.0",
    "vue": "3.5",
    "vue-router": "4.5"
  }
}
